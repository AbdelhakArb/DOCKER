@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <p>Enter your database connection details below.</p>
</div>

@if (ViewBag.Message != null)
{
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="alert @(ViewBag.Success == true ? "alert-success" : "alert-danger")" role="alert">
                @ViewBag.Message
            </div>
        </div>
    </div>
}

@if (ViewBag.Products == null)
{
<div class="row justify-content-center">
    <div class="col-md-6">
        <form asp-controller="Home" asp-action="Connect" method="post">
            <div class="mb-3">
                <label for="url" class="form-label">URL</label>
                <input type="text" class="form-control" id="url" name="url" value="http://localhost:8069/" required />
            </div>
            <div class="mb-3">
                <label for="databaseName" class="form-label">Database Name</label>
                <input type="text" class="form-control" id="databaseName" name="databaseName" value="odoo-db" required />
            </div>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" class="form-control" id="username" name="username" value="test@test.com" required />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" class="form-control" id="password" name="password" value="Test1234*" required />
            </div>
            <button type="submit" class="btn btn-primary">Load products</button>
        </form>
    </div>
</div>
}
else
{
    <div class="row justify-content-center">
        <div class="col-md-10">
            <h2>Products List</h2>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Reference</th>
                        <th>Price</th>
                        <th>Quantity Available</th>
                        <th>Category</th>
                        <th>Max Guests</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in ViewBag.Products)
                    {
                        <tr>
                            <td>@product["id"]</td>
                            <td>@product["name"]</td>
                            <td>@(product.ContainsKey("default_code") && product["default_code"] != null ? product["default_code"] : "N/A")</td>
                            <td>@(product.ContainsKey("list_price") ? product["list_price"] : "0.00")</td>
                            <td>@(product.ContainsKey("qty_available") ? product["qty_available"] : "0")</td>
                            <td>@(product.ContainsKey("categ_id") ? product["categ_id"] : "N/A")</td>
                            <td>@(product.ContainsKey("max_guests") ? product["max_guests"] : "N/A")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}


